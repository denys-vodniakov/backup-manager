# =============================================================================
# Daily backup — MySQL + uploads only
# =============================================================================
# Usage:
#   cp .env.daily.example .env.daily
#   chmod 600 .env.daily
#   ENV_FILE=.env.daily ./backup.sh
#
# Suggested cron: every day at 02:30
# =============================================================================

PROJECT_NAME="novosti"

SOURCE_PATH="${HOME}/www/wp-content/uploads"
BACKUP_DIR="${HOME}/backup-manager/backups"
TMP_DIR="${HOME}/backup-manager/tmp"
LOG_DIR="${HOME}/backup-manager/logs"
RESTORE_TARGET_PATH="${HOME}/www"

RETENTION_LOCAL_DAYS=7

# Progress updates while dumping/archiving (seconds). 0 = silent.
BACKUP_PROGRESS_SECONDS=15

ENABLE_FILE_BACKUP=true
ENABLE_MYSQL_BACKUP=true
DB_HOST="localhost"
DB_NAME="your_wp_database"
DB_USER="your_wp_user"
DB_PASSWORD="your-secure-password"

# Keep false until Hetzner / rclone is ready
ENABLE_REMOTE_UPLOAD=false
RCLONE_BIN="${HOME}/bin/rclone"
RCLONE_REMOTE="hetzner-box"
RCLONE_REMOTE_PATH="backups/novosti"
RETENTION_REMOTE_DAYS=30

ENABLE_NOTIFICATIONS=false
WEBHOOK_URL=""
