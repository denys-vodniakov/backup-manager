# =============================================================================
# backup-manager — Environment configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit .env — it may contain secrets.
# =============================================================================

# --- Project identity ---
PROJECT_NAME="my-website"

# --- Paths (use absolute paths on shared hosting) ---
SOURCE_PATH="${HOME}/www"
BACKUP_DIR="${HOME}/backup-manager/backups"
TMP_DIR="${HOME}/backup-manager/tmp"
LOG_DIR="${HOME}/backup-manager/logs"

# Restore target (used by restore.sh only)
RESTORE_TARGET_PATH="${HOME}/www"

# --- Local retention ---
# Delete local backups older than this many days (0 = keep all)
RETENTION_LOCAL_DAYS=14

# --- File backup ---
ENABLE_FILE_BACKUP=true

# --- MySQL backup ---
ENABLE_MYSQL_BACKUP=false
DB_HOST="localhost"
DB_NAME="my_database"
DB_USER="my_database_user"
DB_PASSWORD="change-me"

# --- Remote upload (rclone) ---
ENABLE_REMOTE_UPLOAD=false
RCLONE_BIN="${HOME}/bin/rclone"
RCLONE_REMOTE="myremote"
RCLONE_REMOTE_PATH="backups/my-website"

# Delete remote backups older than this many days (0 = keep all)
RETENTION_REMOTE_DAYS=30

# --- Notifications (optional webhook, e.g. Slack/Discord) ---
ENABLE_NOTIFICATIONS=false
WEBHOOK_URL="https://example.com/webhook"
