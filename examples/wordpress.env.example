# =============================================================================
# WordPress on shared hosting — example .env
# =============================================================================
# Copy to your backup-manager directory as .env and fill in real credentials.
# Typical layout on OVH Web Cloud: ~/www for WordPress files.
# =============================================================================

PROJECT_NAME="wordpress-site"

SOURCE_PATH="${HOME}/www"
BACKUP_DIR="${HOME}/backup-manager/backups"
TMP_DIR="${HOME}/backup-manager/tmp"
LOG_DIR="${HOME}/backup-manager/logs"
RESTORE_TARGET_PATH="${HOME}/www"

RETENTION_LOCAL_DAYS=7

ENABLE_MYSQL_BACKUP=true
DB_HOST="localhost"
DB_NAME="your_wp_database"
DB_USER="your_wp_user"
DB_PASSWORD="your-secure-password"

ENABLE_REMOTE_UPLOAD=true
RCLONE_BIN="${HOME}/bin/rclone"
RCLONE_REMOTE="ovh-storage"
RCLONE_REMOTE_PATH="backups/wordpress-site"
RETENTION_REMOTE_DAYS=30

ENABLE_NOTIFICATIONS=false
WEBHOOK_URL=""
