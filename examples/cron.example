# =============================================================================
# Cron examples for backup-manager
# =============================================================================
# Setup on server:
#   cp .env.daily.example .env.daily && chmod 600 .env.daily
#   cp .env.weekly.example .env.weekly && chmod 600 .env.weekly
# Edit DB_* and paths, then: crontab -e
# =============================================================================

# --- Daily: MySQL + uploads only (02:30) ---
# 30 2 * * * cd "$HOME/backup-manager" && ENV_FILE=.env.daily ./backup.sh >> "$HOME/backup-manager/logs/cron.log" 2>&1

# --- Weekly full site + MySQL (Sunday 03:00) ---
# 0 3 * * 0 cd "$HOME/backup-manager" && ENV_FILE=.env.weekly ./backup.sh >> "$HOME/backup-manager/logs/cron.log" 2>&1

# --- Biweekly full backup (1st and 15th at 03:00) ---
# 0 3 1,15 * * cd "$HOME/backup-manager" && ENV_FILE=.env.weekly ./backup.sh >> "$HOME/backup-manager/logs/cron.log" 2>&1

# Notes:
# - Do not commit .env.daily / .env.weekly (gitignored).
# - Each run also creates a timestamped log in LOG_DIR.
# - Test manually first:
#     ENV_FILE=.env.daily ./backup.sh
#     ENV_FILE=.env.weekly ./backup.sh
